# ═══════════════════════════════════════════
# YSH — variables de entorno (ejemplo)
# Copia a .env y rellena con secretos reales.
# NUNCA commitees este fichero con valores reales.
# ═══════════════════════════════════════════

# ── Secretos obligatorios ───────────────────
# Genera con:  openssl rand -hex 32
YSH_JWT_SECRET=change-me-32-bytes-random-hex
YSH_DB_PASSWORD=change-me-db-password
YSH_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ── Opcionales ──────────────────────────────
YSH_PORT=8080
RUST_LOG=info
GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me
